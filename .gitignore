# Ambientes, caches e arquivos temporários
.venv/
**/.venv/
__pycache__/
*.py[cod]
*.log
.env
.env.*
!.env.example

# Dados e artefatos pesados ou gerados
*.csv
*.json
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.pdf
*.xlsx
*.zip

# Código de análise e testes locais não fazem parte da publicação
graficos.py
projeto-dashboard/README.md
projeto-dashboard/scripts/
projeto-dashboard/tests/

# O site estático é publicado no Render; manter todos os seus assets versionados
projeto-dashboard/site/*
!projeto-dashboard/site/
!projeto-dashboard/site/**
